// PostgreSQL + pgvector schema for production / containerized environments

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum LessonStatus {
  DRAFT
  EXTRACTED
  REVIEW_PENDING
  APPROVED
  REJECTED
}

enum KnowledgeItemType {
  CONCEPT
  DEFINITION
  PRINCIPLE
  RULE
  CONDITION
  EXCEPTION
  SETUP
  SCENARIO
  EXAMPLE
  COUNTEREXAMPLE
  INVALIDATION
  ENTRY_RULE
  SL_RULE
  TP_RULE
  CONTEXT_RULE
  PREFERENCE
  OBSERVATION
  CORRECTION
}

enum RulePriority {
  CORE_RULE
  STRONG_RULE
  CONDITIONAL_RULE
  PREFERENCE
  OBSERVATION
  EXAMPLE
}

enum RuleStatus {
  ACTIVE
  SUPERSEDED
  UNDER_REVIEW
  DEPRECATED
}

enum RelationType {
  REQUIRES
  INVALIDATES
  REFINES
  CONFLICTS_WITH
  SUPERSEDES
  EXCEPTION_TO
  CORRELATES_WITH
}

enum ConflictStatus {
  UNRESOLVED
  RESOLVED
  DISMISSED
}

enum TradeDirection {
  LONG
  SHORT
  NEUTRAL
}

enum SetupStatus {
  OBSERVATION
  SETUP_FORMING
  SETUP_CONFIRMED
  TRADE_CANDIDATE
  INVALID_SETUP
  WAIT
  NO_TRADE
}

enum ExamResultStatus {
  CORRECT
  PARTIALLY_CORRECT
  WRONG
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("TEACHER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons         Lesson[]
  feedbacks       TeacherFeedback[]
  evaluations     Evaluation[]
  corrections     Correction[]
}

model Lesson {
  id             String       @id @default(cuid())
  title          String
  description    String?
  durationSec    Int?
  videoUrl       String?
  videoPath      String?
  mimeType       String?
  fileSizeBytes  Int?
  status         LessonStatus @default(DRAFT)
  teacherNotes   String?
  extractedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  assets         LessonAsset[]
  transcripts    Transcript[]
  knowledgeItems KnowledgeItem[]
  rules          Rule[]
  examples       Example[]
  counterExamples CounterExample[]
  corrections    Correction[]
  knowledgeVersions KnowledgeVersion[]

  @@index([status])
  @@index([createdAt])
}

model LessonAsset {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assetType    String
  filePath     String
  fileName     String
  fileSize     Int
  mimeType     String
  timestampSec Float?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([lessonId])
  @@index([assetType])
}

model Transcript {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fullText   String
  language   String   @default("en")
  provider   String   @default("whisper")
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  segments   TranscriptSegment[]

  @@index([lessonId])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  startTimeSec Float
  endTimeSec   Float
  text         String
  speaker      String?
  confidence   Float?

  @@index([transcriptId])
  @@index([startTimeSec])
}

model Concept {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  category        String
  definition      String
  summary         String?
  importance      Int      @default(1)
  parentConceptId String?
  parentConcept   Concept? @relation("ConceptHierarchy", fields: [parentConceptId], references: [id], onDelete: SetNull)
  childConcepts   Concept[] @relation("ConceptHierarchy")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules           Rule[]
  knowledgeItems  KnowledgeItem[]
  examples        Example[]
  counterExamples CounterExample[]
  corrections     Correction[]
  evaluations     EvaluationResult[]

  @@index([slug])
  @@index([category])
}

model KnowledgeItem {
  id              String            @id @default(cuid())
  type            KnowledgeItemType
  title           String
  description     String
  conditionsText  String?
  exceptionsText  String?
  priority        RulePriority      @default(CONDITIONAL_RULE)
  confidence      Float?            @default(1.0)
  status          RuleStatus        @default(ACTIVE)
  embedding       Unsupported("vector(1536)")?
  sourceLessonId  String?
  sourceLesson    Lesson?           @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)
  conceptId       String?
  concept         Concept?          @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  supersedesId    String?
  supersededById  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  fromRelations   KnowledgeRelation[] @relation("RelationFrom")
  toRelations     KnowledgeRelation[] @relation("RelationTo")

  @@index([type])
  @@index([status])
  @@index([conceptId])
  @@index([sourceLessonId])
}

model Rule {
  id             String       @id @default(cuid())
  title          String
  statement      String
  rationale      String?
  priority       RulePriority @default(CORE_RULE)
  status         RuleStatus   @default(ACTIVE)
  confidence     Float        @default(1.0)
  version        Int          @default(1)
  
  conceptId      String?
  concept        Concept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  sourceLessonId String?
  sourceLesson   Lesson?      @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)

  supersededById String?
  supersededBy   Rule?        @relation("RuleSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Rule[]       @relation("RuleSupersession")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conditions     Condition[]
  exceptions     Exception[]
  versions       KnowledgeVersion[]
  conflictsAsA   KnowledgeConflict[] @relation("ConflictRuleA")
  conflictsAsB   KnowledgeConflict[] @relation("ConflictRuleB")
  examples       Example[]
  counterExamples CounterExample[]

  @@index([status])
  @@index([priority])
  @@index([conceptId])
}

model Condition {
  id           String   @id @default(cuid())
  ruleId       String
  rule         Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  name         String
  field        String
  operator     String
  threshold    String?
  timeframe    String?
  isMandatory  Boolean  @default(true)
  sequence     Int      @default(0)

  @@index([ruleId])
}

model Exception {
  id                 String   @id @default(cuid())
  ruleId             String
  rule               Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  name               String
  description        String
  overrideBehavior   String
  conditionLogic     String
  exampleContext     String?
  createdAt          DateTime @default(now())

  @@index([ruleId])
}

model Setup {
  id                 String         @id @default(cuid())
  name               String         @unique
  direction          TradeDirection
  description        String
  defaultTimeframe   String         @default("5M")
  triggerCondition   String
  invalidationCriteria String
  riskRewardMin      Float?         @default(2.0)
  status             RuleStatus     @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  scenarios          Scenario[]
  examples           Example[]
  counterExamples    CounterExample[]

  @@index([direction])
  @@index([status])
}

model Scenario {
  id                    String              @id @default(cuid())
  setupId               String?
  setup                 Setup?              @relation(fields: [setupId], references: [id], onDelete: SetNull)
  name                  String
  marketContext         String
  expectedAction        String
  invalidationCondition String
  status                RuleStatus          @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  conditions            ScenarioCondition[]

  @@index([setupId])
}

model ScenarioCondition {
  id          String   @id @default(cuid())
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  stepOrder   Int
  description String
  logicOp     String   @default("AND")
  isMet       Boolean?

  @@index([scenarioId])
  @@index([stepOrder])
}

model Example {
  id             String         @id @default(cuid())
  title          String
  market         String
  timeframe      String
  direction      TradeDirection
  chartImageUrl  String?
  chartImagePath String?
  context        String
  teacherDecision String
  teacherExplanation String
  outcome        String?
  createdAt      DateTime       @default(now())

  lessonId       String?
  lesson         Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  conceptId      String?
  concept        Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  ruleId         String?
  rule           Rule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  setupId        String?
  setup          Setup?         @relation(fields: [setupId], references: [id], onDelete: SetNull)

  @@index([market])
  @@index([conceptId])
  @@index([ruleId])
}

model CounterExample {
  id                 String         @id @default(cuid())
  title              String
  market             String
  timeframe          String
  direction          TradeDirection
  chartImageUrl      String?
  chartImagePath     String?
  context            String
  whyInvalid         String
  teacherExplanation String
  createdAt          DateTime       @default(now())

  lessonId           String?
  lesson             Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  conceptId          String?
  concept            Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  ruleId             String?
  rule               Rule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  setupId            String?
  setup              Setup?         @relation(fields: [setupId], references: [id], onDelete: SetNull)

  @@index([market])
  @@index([conceptId])
  @@index([ruleId])
}

model Correction {
  id                 String   @id @default(cuid())
  lessonId           String?
  lesson             Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  conceptId          String?
  concept            Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  previousAiDecision String
  correctedDecision  String
  explanation        String
  affectedRulesText  String?
  createdAt          DateTime @default(now())

  @@index([conceptId])
  @@index([createdAt])
}

model KnowledgeRelation {
  id           String            @id @default(cuid())
  fromId       String
  fromItem     KnowledgeItem     @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  toItem       KnowledgeItem     @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  relationType RelationType
  description  String?
  confidence   Float             @default(1.0)
  createdAt    DateTime          @default(now())

  @@index([fromId])
  @@index([toId])
  @@index([relationType])
}

model KnowledgeConflict {
  id               String         @id @default(cuid())
  ruleAId          String
  ruleA            Rule           @relation("ConflictRuleA", fields: [ruleAId], references: [id], onDelete: Cascade)
  ruleBId          String
  ruleB            Rule           @relation("ConflictRuleB", fields: [ruleBId], references: [id], onDelete: Cascade)
  conflictType     String
  aiInterpretation String
  suggestedAction  String
  status           ConflictStatus @default(UNRESOLVED)
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@index([ruleAId])
  @@index([ruleBId])
  @@index([status])
}

model KnowledgeVersion {
  id           String   @id @default(cuid())
  ruleId       String
  rule         Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version      Int
  statement    String
  changeReason String
  lessonId     String?
  lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([ruleId])
}

model Evaluation {
  id                 String             @id @default(cuid())
  title              String
  type               String
  totalQuestions     Int                @default(0)
  correctAnswers     Int                @default(0)
  partialAnswers     Int                @default(0)
  incorrectAnswers   Int                @default(0)
  overallScore       Float?
  notes              String?
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())

  results            EvaluationResult[]

  @@index([createdAt])
}

model EvaluationResult {
  id            String           @id @default(cuid())
  evaluationId  String
  evaluation    Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  conceptId     String?
  concept       Concept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  market        String
  timeframe     String
  aiDecision    String
  aiReasoning   String
  actualDecision String
  status        ExamResultStatus
  feedbackNotes String?
  createdAt     DateTime         @default(now())

  @@index([evaluationId])
  @@index([conceptId])
}

model MarketObservation {
  id             String   @id @default(cuid())
  symbol         String
  timeframe      String
  price          Float
  detectedLevels Json?
  marketState    String
  notes          String?
  createdAt      DateTime @default(now())

  @@index([symbol, timeframe])
  @@index([createdAt])
}

model AnalysisSession {
  id             String             @id @default(cuid())
  source         String
  symbol         String?
  timeframe      String?
  status         String             @default("ACTIVE")
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  totalSnapshots Int                @default(0)

  snapshots      AnalysisSnapshot[]

  @@index([status])
  @@index([startedAt])
}

model AnalysisSnapshot {
  id             String          @id @default(cuid())
  sessionId      String
  session        AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  imagePath      String?
  hasVisualDiff  Boolean         @default(false)
  diffScore      Float?
  marketState    String
  activeScenario String?
  setupStatus    SetupStatus     @default(NO_TRADE)
  direction      TradeDirection  @default(NEUTRAL)
  entryPrice     Float?
  stopLossPrice  Float?
  takeProfitPrices Json?
  reasoning      Json
  createdAt      DateTime        @default(now())

  aiResponse     AIResponse?

  @@index([sessionId])
  @@index([setupStatus])
  @@index([createdAt])
}

model AIResponse {
  id               String            @id @default(cuid())
  snapshotId       String?           @unique
  snapshot         AnalysisSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  promptPayload    String
  rawOutput        String
  structuredOutput Json
  modelUsed        String
  latencyMs        Int?
  tokensUsed       Int?
  status           SetupStatus
  createdAt        DateTime          @default(now())

  feedback         TeacherFeedback?

  @@index([status])
  @@index([createdAt])
}

model TeacherFeedback {
  id           String      @id @default(cuid())
  aiResponseId String      @unique
  aiResponse   AIResponse  @relation(fields: [aiResponseId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  isApproved   Boolean
  rating       Int?
  comment      String?
  correctedWhy String?
  createdAt    DateTime    @default(now())

  @@index([isApproved])
}
