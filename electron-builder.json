{
  "appId": "com.guardedmarkets.tradingai",
  "productName": "TradingAI",
  "directories": {
    "output": "dist"
  },
  "asar": false,
  "files": [
    "electron/**/*",
    ".next/**/*",
    "public/**/*",
    "prisma/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/electron/**/*",
    "!node_modules/electron-builder/**/*",
    "!node_modules/app-builder-bin/**/*",
    "!node_modules/@types/**/*",
    "!node_modules/typescript/**/*",
    "!node_modules/tailwindcss/**/*",
    "!node_modules/postcss/**/*",
    "!node_modules/autoprefixer/**/*",
    "!public/TradingAI-Setup.exe",
    "!src/**/*",
    "!.git/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma",
      "to": "app/node_modules/.prisma"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "TradingAI-Setup.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TradingAI"
  }
}
